# Copy to .env and fill in only what you use. Never commit .env.

# Local models: one llama-server per model, OpenAI-compatible endpoints (no key needed)
LLAMA_SUT_URL=http://localhost:8080/v1
LLAMA_JUDGE_URL=http://localhost:8081/v1
LLAMA_EMBED_URL=http://localhost:8082/v1

# Optional: TypeSafe Jev judge (paid, pay-per-use; used only by the judge-jev-*.yaml configs)
# TYPESAFE_API_KEY=

# Optional: tracing in M09
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Do NOT set ANTHROPIC_API_KEY. Claude tools then bill the key instead of your Pro subscription.
